# Copy to .env and fill in. .env is git-ignored.

# --- MongoDB ---
MONGO_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=yg_trader_hunt

# --- Elefin partner API (KEY and SECRET are combined as "KEY.SECRET" for the Bearer token) ---
ELEFIN_API_KEY=fxcrm_pk_xxxxxxxx
ELEFIN_API_SECRET=fxcrm_sk_xxxxxxxx
ELEFIN_API_BASE_URL=https://el.theloginarea.com/api/v1

# --- Refresh scheduling ---
# The scheduler runs window-score (mark-to-market: closed + open positions) on this cron.
REFRESH_CRON=*/15 * * * *
# How often the browser re-fetches our own /api/leaderboard.
UI_POLL_MINUTES=5

# --- Scoring / eligibility ---
SCORE_FORMULA=net_profit          # net_profit (ranking = net_profit_window / base_start) | equity (stored as return_pct_alt only)
MIN_DEPOSIT_USD=95               # min cumulative deposit (USD, FX-normalised); allows for payment-rail fees on a $100 deposit
REQUIRE_TRADE=true                # must have at least one trade *during the window*
USDT_TO_INR_RATE=102             # only used to normalise the displayed USD P/L column
LEADERBOARD_SIZE=33             # rows shown in the standings table (whole sep-2026 cohort)
SHORTLIST_SIZE=5                 # highlighted "shortlist" band
DEPOSIT_TOLERANCE_USD=1          # in-window deposit above this (USD) => flagged "added funds", barred from the prize

# --- Competition window (IST) ---
COHORT=sep-2026                            # which participants (participants.cohort) the refresh job scores
COMPETITION_START=2026-09-07T00:00:00+05:30
COMPETITION_END=2026-09-11T23:59:59+05:30  # trading cutoff
WINNER_ANNOUNCE=2026-09-12T12:00:00+05:30  # public winner reveal + /api/leaderboard/result gate (day after)
BASELINE_GRACE_HOURS=2          # window after the start in which capture-baseline may still re-freeze the start line

# --- Manual refresh endpoint guard ---
REFRESH_TOKEN=set-a-long-random-string

# --- Dev ---
# MOCK_ELEFIN=1                  # serve fixtures/elefin-sample.json instead of calling Elefin
PORT=3005
