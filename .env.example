# =====================================================================================
# EXAMPLE of the LIVE .env for Traders Hunt Season 2.
# Copy this file to `.env`, then replace every <PLACEHOLDER>. Never put real secrets in
# this file: it is NOT git-ignored. The real `.env` is.
#
# Run with:  npm start
# =====================================================================================

# --- Server --------------------------------------------------------------------------
PORT=3005
# The site runs behind one HTTPS reverse proxy. Use 0 for a direct connection.
TRUST_PROXY=1

# --- MongoDB -------------------------------------------------------------------------
MONGO_URI=<mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=Cluster0>
MONGO_DB_NAME=yg_trader_hunt

# --- Elefin partner API (combined as "KEY.SECRET" for the Bearer token) -------------------
ELEFIN_API_KEY=<fxcrm_pk_...>
ELEFIN_API_SECRET=<fxcrm_sk_...>
ELEFIN_API_BASE_URL=https://el.theloginarea.com/api/v1
# The key is IP-allowlisted on IPv4, so outbound calls are forced to IPv4. Set 0 to allow IPv6.
ELEFIN_IPV4=1
# The key allows 60 requests/minute. Keep at least 1100 ms between calls.
ELEFIN_MIN_INTERVAL_MS=1100

# --- Scoring schedule ----------------------------------------------------------------
# How often traders are re-scored. A full pass must finish well inside this interval.
REFRESH_CRON=*/15 * * * *
# How often the website re-fetches /api/leaderboard.
UI_POLL_MINUTES=5

# --- Season 2 dates (all IST, all required) ------------------------------------------
# COHORT names every database record of this season. Do not reuse an old season's value.
COHORT=nov-2026
# Monday: scoring starts, first funded entry becomes the trader's baseline.
COMPETITION_START=2026-11-09T00:00:00+05:30
# Late entry closes 23:59:59 IST two days after the start date (Wednesday).
# Leave empty to use that default, or set an exact time.
ENTRY_CUTOFF=
# Scores stop moving here. The board stays open until an admin clicks Finalize.
COMPETITION_END=2026-11-14T23:59:59+05:30
# Must be on or after COMPETITION_END.
WINNER_ANNOUNCE=2026-11-15T12:00:00+05:30

# --- Week 2: Beat YG Sir (both dates, or leave both empty to keep week 2 locked) ------
# Must be on or after COMPETITION_END. Everyone starts from WEEK2_START.
WEEK2_START=2026-11-16T09:00:00+05:30
WEEK2_END=2026-11-22T23:59:59+05:30
# A challenger who finishes #1 ahead of YG Sir gets their category prize multiplied by this.
WEEK2_REWARD_MULTIPLIER=2

# --- Scoring rules -------------------------------------------------------------------
# Minimum equity (USD) at first entry. $100 deposits land at about $98-99.5 after fees.
MIN_CAPITAL_USD=95
# Allowed difference (USD) between account totals and the deposit ledger / balance check.
FLOW_TOLERANCE_USD=1
PNL_TOLERANCE_USD=1
# If more than this fraction of accounts fail in one run, nothing is published.
MAX_FAILED_FRACTION=0.2

# --- Registration mirror to the Google sheet -----------------------------------------
# Apps Script web app URL. The sheet needs these columns:
#   name, phone, email, capital, wallet_id, timestamp
GOOGLE_FORM_ENDPOINT=https://script.google.com/macros/s/AKfycbzFPo5fUGFS5nf0Qwr3K-Bhxb4h-34HXAFGO4Eeoi0fhFmeS0A_oY4JYTXxxVasnDRX/exec

# https://script.google.com/macros/s/AKfycbzFPo5fUGFS5nf0Qwr3K-Bhxb4h-34HXAFGO4Eeoi0fhFmeS0A_oY4JYTXxxVasnDRX/exec

curl -L -d "name=Test&phone=1&email=t@t.com&capital=100&wallet_id=1&timestamp=now" "https://script.google.com/macros/s/AKfycbzFPo5fUGFS5nf0Qwr3K-Bhxb4h-34HXAFGO4Eeoi0fhFmeS0A_oY4JYTXxxVasnDRX/exec
# --- Admin panel (single user) -------------------------------------------------------
# Secret, unlinked URL of the admin page.
ADMIN_PATH=</ops-RANDOM-STRING>
# Exactly one user, written user:hash. Make the hash with:  npm run admin -- hash-password
ADMIN_USERS=elevana:<paste-the-scrypt-hash>
# At least 32 random characters. Changing it logs every admin out.
ADMIN_SESSION_SECRET=<64-random-characters>

# --- Manual refresh endpoint ---------------------------------------------------------
# Header x-refresh-token must equal this to trigger POST /api/leaderboard/refresh.
REFRESH_TOKEN=d795633bfeb1d3ebfa21530106716f2b16750d8dc7de05903490bdbadff24da1
